# Copy to ~/.config/now-playing-apple-music/.env (Linux),
# ~/Library/Application Support/now-playing-apple-music/.env (macOS), or
# %APPDATA%\now-playing-apple-music\.env (Windows).

# Signed MusicKit developer token (JWT). Generate locally with:
#   musickit-sign-token --config config/examples/musickit-signing.example.json
# Do not commit real tokens or .p8 keys.
MUSICKIT_DEVELOPER_TOKEN=

# Music user token from MusicKit user authorization (see README).
MUSICKIT_USER_TOKEN=

# Apple Music storefront country code (default: us)
MUSICKIT_STOREFRONT=us
